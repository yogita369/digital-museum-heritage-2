# Settings for YOUR Cloudflare, HCP Terraform and GitHub accounts.
#
# Create your own copy (git-ignored) with a generated curator key:
#   npm run doctor -- --init-env
# then fill in the empty values below in your editor and run:
#   npm run doctor
#
# Never commit .env and never paste these values into a chat or a screenshot.

# Cloudflare -> My Profile -> API Tokens -> Create Token -> Custom token.
# Permissions: Account / Workers Scripts / Edit  and  Account / Workers KV Storage / Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare -> Workers & Pages -> Account details -> Account ID (32 hexadecimal characters)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare -> Workers & Pages -> Account details -> Subdomain.
# Only the <name> part of <name>.workers.dev
WORKERS_SUBDOMAIN=

# HCP Terraform (https://app.terraform.io) -> your organization's name
TF_CLOUD_ORGANIZATION=

# HCP Terraform -> Account settings -> Tokens -> Create an API token
TF_API_TOKEN=

# Key curators type into the app to add, edit and delete artifacts.
# `node scripts/doctor.mjs --init-env` fills this in with a random value.
CURATOR_API_KEY=
